skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #314952
skinparam activity {
  BackgroundColor #F1F6F6
  BorderColor #43636A
  FontColor #172D31
  DiamondBackgroundColor #FFF5DD
  DiamondBorderColor #816627
  StartColor #314952
  EndColor #314952
}
skinparam partition {
  BackgroundColor white
  BorderColor #899C9E
}
