@startuml
!include thesis-style.iuml
start
partition "python-graphs" {
  :Đọc mã nguồn thành cây cú pháp và đồ thị điều khiển;
  :Từ điểm vào, chuyển tập lần ghi theo chiều thực thi;
  :Hợp các tập ở chỗ nhập nhánh, cập nhật khi ghi biến;
  :Xét lại nút kế tiếp khi trạng thái ra thay đổi;
  :Nối mỗi lần truy cập tới các lần ghi có thể đến đó;
}
partition "Mô-đun phân tích ControlFlow" {
  :Duyệt cạnh LAST_WRITE từ điểm truy cập về điểm ghi;
  :Giữ đầu đọc là tên biến và đầu ghi có số dòng;
  :Xuất bộ ba (tên biến, dòng ghi, dòng đọc), bỏ trùng;
}
stop
@enduml
