{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:concept-diagnostic:reply-draft:20261020",
  "title": "Small claim/query record; semantic validity is scored separately, never a generation admission gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement",
          "stance",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 16
          },
          "kind": {
            "enum": [
              "normative",
              "implementation",
              "mismatch"
            ]
          },
          "statement": {
            "type": "string",
            "maxLength": 700
          },
          "stance": {
            "enum": [
              "candidate",
              "keep",
              "revise",
              "withdraw",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "uncertainty": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "claim",
          "prediction",
          "why"
        ],
        "properties": {
          "action": {
            "type": "object",
            "description": "Validate independently with the published v30 tool-specific schema; only inspect_flow, inspect_data, replay_input. Invalid siblings do not erase valid actions."
          },
          "claim": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16
          },
          "prediction": {
            "type": "string",
            "maxLength": 300,
            "description": "Concrete expected observation under the claim, or competing outcomes; this is a model prediction, NOT trusted expected output."
          },
          "why": {
            "type": "string",
            "maxLength": 400,
            "description": "Which alternative observations would change the claim or next query? No unsupported assertion that this input reveals a bug."
          }
        }
      }
    },
    "later_queries": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "claim",
          "prediction",
          "why"
        ],
        "properties": {
          "action": {
            "type": "object",
            "description": "Validate independently with the published v30 tool-specific schema; only inspect_flow, inspect_data, replay_input. Invalid siblings do not erase valid actions."
          },
          "claim": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16
          },
          "prediction": {
            "type": "string",
            "maxLength": 300,
            "description": "Concrete expected observation under the claim, or competing outcomes; this is a model prediction, NOT trusted expected output."
          },
          "why": {
            "type": "string",
            "maxLength": 400,
            "description": "Which alternative observations would change the claim or next query? No unsupported assertion that this input reveals a bug."
          }
        }
      },
      "description": "Only concept_committed turn1; both batches freeze before any new feedback."
    },
    "final_inputs": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "note": {
      "type": "string",
      "maxLength": 600
    }
  }
}
