          "code": "import math\n\ndef closest_integer(value):\n    num = float(value)\n    if num >= 0:\n        if num - math.floor(num) >= 0.5:\n            return math.ceil(num)\n        else:\n            return math.floor(num)\n    else:\n        # For negative numbers: -14.5 -> floor is -15, ceil is -14\n        # Distance to -15 is 0.5, distance to -14 is 0.5\n        # We need the one farthest from zero: -15\n        if num - math.floor(num) >= 0.5:\n            return math.floor(num)\n        else:\n            return math.ceil(num)",
