{
  "types": {
    "value": "int",
    "lower": "int",
    "upper": "int"
  },
  "branches": [
    "invalid range: lower > upper",
    "lower boundary: value < lower",
    "upper boundary: value > upper"
  ],
  "expected_oracle": "classify_window returns -2 for invalid ranges, -1 below, 0 inside inclusive bounds, and 1 above",
  "boundary_cases": [
    {"inputs": [5, 10, 0], "expected": -2, "reason": "invalid range guard"},
    {"inputs": [4, 5, 10], "expected": -1, "reason": "below lower bound"},
    {"inputs": [10, 5, 10], "expected": 0, "reason": "upper equality stays in range"},
    {"inputs": [11, 5, 10], "expected": 1, "reason": "above upper bound"}
  ]
}
