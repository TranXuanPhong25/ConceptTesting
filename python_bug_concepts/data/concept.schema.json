{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^py\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "python"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "where": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "ast_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "location_template": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "ast_nodes",
        "preconditions",
        "location_template"
      ],
      "additionalProperties": false
    },
    "how": {
      "type": "object",
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "trigger_template": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mechanism",
        "trigger_template"
      ],
      "additionalProperties": false
    },
    "what": {
      "type": "object",
      "properties": {
        "observable_failure": {
          "type": "string",
          "minLength": 1
        },
        "oracle_template": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "observable_failure",
        "oracle_template"
      ],
      "additionalProperties": false
    },
    "applicability_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pattern_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_status": {
      "const": "curated_hypothesis"
    },
    "required_bindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "language",
    "category",
    "aliases",
    "where",
    "how",
    "what",
    "applicability_notes",
    "pattern_ids",
    "evidence_status",
    "required_bindings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Python bug concept card",
  "description": "Canonical card schema; exported JSONL adds resolved sources."
}
